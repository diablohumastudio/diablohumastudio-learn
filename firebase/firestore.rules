rules_version = '2';

// Practice data (see docs/practice.md), exams (docs/exam.md), deliverables (docs/deliverables.md)
// and course membership (docs/courses.md).
// Paste into Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // Enrolled in a course (docs/courses.md): a teacher wrote courses/{course}/members/{uid}.
    // Signing in creates an account, not a membership.
    function isMember(courseSlug) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseSlug)/members/$(request.auth.uid));
    }

    // Whether a homework, an exam or a deliverable is for the caller: a member of its course, and
    // either it is for everybody or the caller is listed in `assignedUids` (docs/courses.md). A
    // document saved before those two fields existed is for everybody.
    function isAssignedTo(data) {
      return isMember(data.courseSlug)
        && (data.get('forEveryone', true) == true || request.auth.uid in data.get('assignedUids', []));
    }

    // True from the moment a teacher opens an exam until its clock ends. The exam API writes
    // settings/examLock when it opens or closes one.
    function examRunning() {
      return exists(/databases/$(database)/documents/settings/examLock)
        && get(/databases/$(database)/documents/settings/examLock).data.closesAt > request.time;
    }

    function examIsOver(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data.closesAt <= request.time;
    }

    // The subtree holds questions, sessions and days (homework): all written by the student's
    // own browser, so a student can forge them. Accepted for homework; exams go through the API.
    match /students/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow write: if isOwner(uid);

      match /{document=**} {
        allow read: if isOwner(uid) || isTeacher();
        allow write: if isOwner(uid);
      }
    }

    // The question bank: any student can read it, only teachers edit it.
    // SIDE EFFECT ON PURPOSE: while an exam runs, practice is paused for EVERY non-teacher
    // account, not only for the students taking it. The bank holds the correct answers and
    // Firebase cannot tell an examinee from a second account they opened in another tab.
    match /questions/{questionId} {
      allow read: if isTeacher() || (isSignedIn() && !examRunning());
      allow write: if isTeacher();
    }

    // Questions that exist for exams only: a student must never read them, exam or no exam.
    // The exam API (admin SDK) reads them when it builds the paper.
    match /examQuestions/{questionId} {
      allow read, write: if isTeacher();
    }

    // Courses (docs/courses.md). The course document itself never exists: only its members and
    // the requests for access hang under it.
    match /courses/{courseSlug} {
      // Enrolled students. A teacher enrolls; a student reads only their own membership.
      match /members/{uid} {
        allow read: if isOwner(uid) || isTeacher();
        allow write: if isTeacher();
      }

      // A student asking for access: created by the student, closed by a teacher (accepting
      // enrolls and deletes it; rejecting deletes it, so the student may ask again).
      match /requests/{uid} {
        allow read: if isOwner(uid) || isTeacher();
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isTeacher();
      }
    }

    // Specific homeworks (docs/practice.md): which questions, which days, how many answers a day.
    // The students it is for read it (their queries filter by course and by assignment, which
    // is what lets the rule be checked); the answers are counted in each student's own subtree.
    match /homeworks/{homeworkId} {
      allow read: if isTeacher() || isAssignedTo(resource.data);
      allow write: if isTeacher();
    }

    // Exams. Browsers only ever write drafts; opening, starting, submitting and grading go
    // through the API routes (src/pages/api/exam), which use the admin SDK and skip these rules;
    // the start route checks the membership and the assignment itself.
    match /exams/{examId} {
      // A student's list queries filter by course, status and assignment, so all can be checked here.
      allow read: if isTeacher() || (resource.data.status == 'opened' && isAssignedTo(resource.data));
      allow create: if isTeacher() && request.resource.data.status == 'draft';
      allow update: if isTeacher() && resource.data.status == 'draft' && request.resource.data.status == 'draft';
      allow delete: if isTeacher() && resource.data.status == 'draft';

      // The frozen questions and answers of one student. Never holds which option is correct.
      match /attempts/{uid} {
        allow read: if isOwner(uid) || isTeacher();
        allow write: if false;
      }

      // Score and correct options: the student sees them once the exam clock is over.
      match /grades/{uid} {
        allow read: if isTeacher() || (isOwner(uid) && examIsOver(examId));
        allow write: if false;
      }

      // The paper with the answer key: no browser reads it, not even a teacher's.
      match /private/{document} {
        allow read, write: if false;
      }
    }

    // Deliverables (docs/deliverables.md): homeworks and exams handed in as text written on the
    // platform or as a link. Teachers manage them from the browser; the students it is for read
    // it once opened and write their own submission, which the server stamps.
    function canSubmit(deliverableId) {
      return get(/databases/$(database)/documents/deliverables/$(deliverableId)).data.status == 'opened'
        && isAssignedTo(get(/databases/$(database)/documents/deliverables/$(deliverableId)).data);
    }

    match /deliverables/{deliverableId} {
      // A student's list queries filter by course, status and assignment, so all can be checked here.
      allow read: if isTeacher() || (resource.data.status == 'opened' && isAssignedTo(resource.data));
      allow write: if isTeacher();

      // What the student handed in. `savedAt` must be the server's clock, so a save after the
      // close shows as late however the device clock was set; `firstSavedAt` never changes.
      match /submissions/{uid} {
        allow read: if isOwner(uid) || isTeacher();
        allow create: if isOwner(uid)
          && canSubmit(deliverableId)
          && request.resource.data.savedAt == request.time
          && request.resource.data.firstSavedAt == request.time;
        allow update: if isOwner(uid)
          && canSubmit(deliverableId)
          && request.resource.data.savedAt == request.time
          && request.resource.data.firstSavedAt == resource.data.firstSavedAt;
        allow delete: if false;
      }

      // Score and comment, written by a teacher; the student reads their own as soon as it exists.
      match /reviews/{uid} {
        allow read: if isOwner(uid) || isTeacher();
        allow write: if isTeacher();
      }
    }

    match /settings/examLock {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Created by hand in the console; nobody can grant themselves the role.
    match /teachers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
